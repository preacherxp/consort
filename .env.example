AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_ID=typesafe/jev-1.13
# Local PostgreSQL: docker compose --env-file .env -f deploy/compose.postgres.local.yaml up -d --wait
# Generate two different passwords with openssl rand -hex 32.
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
# Replace PASSWORD with POSTGRES_PASSWORD above; URL-encode special characters.
DATABASE_URL=postgresql://consort:PASSWORD@127.0.0.1:5438/consort
PORT=3007
HOST=127.0.0.1
# Set to your exact public origin if deploying behind a reverse proxy.
# APP_ORIGIN=https://jev.purecode.sh
# Docker/Caddy production settings: see .env.production.example and docs/deployment.md
