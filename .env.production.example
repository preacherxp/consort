# Copy to .env.production (standalone) or .env.jev beside your existing Compose file.
# Do not commit filled-in files. chmod 600 the file after copying.
# Public visitors can make paid routing requests. Use a dedicated key with a spending cap.
OPENROUTER_API_KEY=

# Publish your own image before using the existing-stack overlay.
# Prefer an immutable release tag or digest over latest on the production server.
JEV_IMAGE=ghcr.io/preacherxp/consort:latest
